# Copy to .env and fill in. Never commit .env.

# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD allows 5 requests per 30 seconds instead of 50.
NVD_API_KEY=

# Where the SQLite cache is stored (optional)
CVE_CACHE_PATH=cache/retrieval.sqlite3

# Task 1 - local AI model for the LLM fallback (Ollama). All optional.
# Pull it once with: ollama pull llama3.1:8b   (or use llama3.2:3b on a slower laptop)
OLLAMA_MODEL=llama3.1:8b
# Leave blank for the local Ollama, or point it at the team's shared host
OLLAMA_HOST=
# Seconds to wait for an answer (CPU-only laptops are slow)
OLLAMA_TIMEOUT=120
